# ==============================================================================
# HayabusaPress (HBP) - Environment Configuration Example
# ==============================================================================

# Placement outside the public root (Method B)
# Set this when the application itself lives outside the public root, e.g. on shared hosting.
# Alternatively, define('HBP_BASE_PATH', '/home/user/hbp-app') in public/index.php.
# Not needed on a VPS / dedicated server where public/ is already the document root.
# HBP_BASE_PATH=""

# Acknowledging nested placement (Method A, .htaccess rewrite)
# With Method A the application sits directly at the public root, so ROOT_PATH ends up
# nested inside DOCUMENT_ROOT and bootstrap's dangerous-placement check stops with a 503.
# That nesting is the normal layout for Method A, so you can lift the stop by placing
# deploy/htaccess.root at the public root as .htaccess, confirming that
# "https://your-site/.env returns 403/404", and then setting this to true.
# NOTE: If Method B (placement outside the public root) is available, prefer it and
# leave this false - it is the most robust option.
# HBP_ALLOW_NESTED_ROOT=false

# Basic site settings
SITE_NAME="HayabusaPress"
SITE_URL="https://example.com"

# Footer credit link ("Powered by HayabusaPress" -> https://hayabusapress.org).
# On by default; set to false to hide it. The value is read while the page is being
# rendered and baked into the full-page cache, so purge all caches after changing it
# (php core/cli.php system:init, or Admin -> Maintenance).
SITE_CREDIT_LINK=true

# Site logo, used as the last step of the featured-image fallback chain
# (explicit setting -> first image in the body -> this logo -> none). It also
# backs og:image where a post has no image of its own. Give a URL or a path
# relative to the document root; leave empty to disable the fallback.
SITE_LOGO=""

# [MOST IMPORTANT] Site-wide default language code (the one that occupies the root `/`)
SITE_DEFAULT_LANG="en"

# Obscured admin URL
ADMIN_PATH="admin"

# Database connection (multi-database support)
# Options: mysql / pgsql
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hayabusapress
DB_USERNAME=hbp_user
DB_PASSWORD=hbp_secure_password

# DB connection character set (usually no need to change; full UTF-8 support by default)
# When empty, a safe per-driver default is used: mysql=utf8mb4 / pgsql=UTF8
#   mysql: connection character set. utf8mb4 is strongly recommended for emoji and
#          multilingual content.
#   pgsql: client_encoding. Automatically converted to/from the server DB encoding.
#          utf8mb4/utf8 are normalized to UTF8. Only [A-Za-z0-9_-] are allowed.
# NOTE: The encoding of a PostgreSQL database itself is fixed at CREATE DATABASE time
#       (e.g. CREATE DATABASE ... ENCODING 'UTF8' TEMPLATE template0;) and cannot be
#       changed afterwards. Connecting to a non-UTF8 database shows a warning in the admin.
DB_CHARSET=

# Password hashing strategy
# Options: bcrypt / argon2id
PASSWORD_ALGO=bcrypt

# Application key (key for HMAC and encryption)
# Set the base64(32 bytes) value generated by: php core/cli.php tool:key
APP_KEY="base64:CHANGE_ME"

# Super User account
SUPER_USER_EMAIL="admin@example.com"
SUPER_USER_PASSWORD_HASH='$2y$10$...'

# Super User display name (reflected in authors.cache.php)
SUPER_USER_NAME="Super User"

# Super User admin UI language
SUPER_USER_LOCALE="en"

# Super User profile (baked into authors.cache.php)
SUPER_USER_AVATAR="avatar_super.jpg"
SUPER_USER_BIO="Chief administrator of HayabusaPress."
SUPER_USER_X="https://x.com/superuser"
SUPER_USER_GITHUB="https://github.com/superuser"

# Super User 2FA secret (leave empty to disable 2FA)
SUPER_USER_2FA_SECRET=""

# Anti-spam defense level
# 0: off, 1: honeypot only, 2: hybrid maximum defense
ANTISPAM_LEVEL=2

# DNS-BL (timeout-controlled, fail-open)
# Spamhaus refuses queries arriving through public resolvers (1.1.1.1, 8.8.8.8, ...) and answers
# 127.255.255.254, which is treated as "unknown", not as a listing. Point DNSBL_RESOLVER at your own or
# your host's resolver (or use Spamhaus DQS) for lookups to have any effect.
DNSBL_ENABLED=false
DNSBL_ZONE="zen.spamhaus.org"
DNSBL_RESOLVER="1.1.1.1"
DNSBL_TIMEOUT_MS=300
DNSBL_ON_HIT="moderate"

# External spam-detection API key (leave empty to skip external requests)
EXTERNAL_SPAM_API_KEY=""

# CSP (monitor with report-only, then move to enforce)
CSP_MODE=report-only
# Off-site hosts allowed on public pages, comma-separated (e.g. "pics.example.com,*.cdn.example.net").
# CSP_IMG_HOSTS lets images from those hosts load (banners from a partner programme, for example).
# CSP_SCRIPT_HOSTS lets <script src> from those hosts run. Keep it empty unless you need it: every
# host is an outbound request from every page, and it weakens the CSP.
# After changing either, run: php core/cli.php assets:rebuild
CSP_IMG_HOSTS=""
CSP_SCRIPT_HOSTS=""

# Disclosure printed at the top of posts marked "contains promotional content".
# Empty = the localized default ("This article contains promotional content." / "本記事はプロモーションを含みます。").
# Baked into each post when it is saved: run php core/cli.php posts:recompile after changing it.
SPONSORED_NOTICE_TEXT=""

# Uploaded JPEG/PNG also get a WebP copy ({file}.webp, kept only when smaller), served through <picture>.
# auto = when GD supports WebP / off = never
IMAGE_WEBP=auto
# Uploaded images: larger ones are scaled down so the longer side is at most IMAGE_MAX_EDGE pixels
# (0 = keep the original size). Images over IMAGE_MAX_PIXELS are refused before they are decoded.
# IMAGE_MEMORY_LIMIT is how far memory_limit may be raised while an image is processed.
IMAGE_MAX_EDGE=2560
IMAGE_MAX_PIXELS=50000000
IMAGE_MEMORY_LIMIT=256M

# Multi-locale
AUTO_LANG_REDIRECT=false
EMBED_HOSTS="www.youtube-nocookie.com,player.vimeo.com"

# Pagination
LIST_PAGE_SIZE=10
LIST_FPC_DEPTH=10
# Posts per page of a series' table of contents (/post/series/{slug}), and how many pages it may
# have. Its own depth rather than LIST_FPC_DEPTH, so the whole series is listed: 100 x 100 = 10,000.
SERIES_PAGE_SIZE=100
SERIES_FPC_DEPTH=100
# A collection page lists its series on one page, at most this many
COLLECTION_MAX_SERIES=200

# Reading time, baked into each post on save (run posts:recompile after changing the speeds).
# CJK characters are timed by characters per minute and everything else by words per minute; a body
# mixing the two gets the sum.
READING_SPEED_CJK=500
READING_SPEED_WORDS=220
# Show "N min read" on posts in the bundled theme. The value is baked into cached pages: purge all
# page caches after changing it (php core/cli.php system:init, or Admin -> Maintenance).
SHOW_READING_TIME=true

# Public search
# Search is the one public route that queries the DB per request: the set of possible queries is
# unbounded, so there is nothing finite to precompile. The caps below are what keep that bounded.
SEARCH_ENABLED=true
# auto | fulltext | like
#   auto     = FULLTEXT+ngram on MySQL, LIKE (pg_trgm-accelerated) on PostgreSQL
#   like     = force LIKE. Use on MariaDB, which has no ngram parser
SEARCH_MODE=auto
# Terms shorter than this can never match under MySQL's ngram parser (ngram_token_size = 2)
SEARCH_MIN_CHARS=2
SEARCH_MAX_CHARS=64
SEARCH_MAX_TERMS=8
# Caps OFFSET the same way LIST_FPC_DEPTH does for listings
SEARCH_MAX_PAGES=10

# Archive sidebar widget
# The widget only renders this many months, and the query is bounded to the same window so it never
# has to aggregate the entire post history to find them.
ARCHIVE_WIDGET_MONTHS=24

# Sitemap generation
# auto = rebuild from a save, at most once per SITEMAP_MIN_INTERVAL
# cron = never rebuild from a save; run `php core/cli.php sitemap:rebuild --if-pending` instead
SITEMAP_MODE=auto
SITEMAP_MIN_INTERVAL=300

# Permissions for media storage directories
# Mode used when auto-creating the destination (parent plus the {ab}/{cd}/ shard levels)
# during upload. Default 0755. Change only when your host requires something else (e.g. 0775).
MEDIA_DIR_MODE=0755

# CSS delivery strategy (inline | external)
# external is recommended for blogs where readers browse multiple pages
CSS_DELIVERY=external

# true for themes that show the author in listings
THEME_SHOWS_AUTHOR_IN_LIST=false

# Admin-panel operations that change code or the database schema are off by default.
# The recommended way is SSH and the CLI. To allow one from the admin panel, write the
# date and time (YYYY-MM-DD HH:MM in APP_TIMEZONE) until which it is allowed; it closes
# by itself then, and a date more than 24 hours ahead is ignored. The admin panel also
# asks for the password again before each of these operations.
#   ALLOW_PLUGIN_INSTALL="2026-11-01 12:00"
# Plugin ZIP installation (Admin > Plugins). true still works but never closes.
ALLOW_PLUGIN_INSTALL=false

# Theme ZIP installation (Admin > Themes). Themes contain .tpl.php files.
# true still works but never closes.
ALLOW_THEME_INSTALL=false

# Database upgrade (migrations) from the admin panel. Takes a date only, never true.
#WEB_UPGRADE_UNTIL="2026-11-01 12:00"

# Files changed outside the admin panel (checked at admin login and on rebuilds, never per request).
# A plugin whose files changed is only reported (warn), or kept out until the change is accepted
# (disable). A changed file that does not parse always keeps its plugin out.
PLUGIN_MODIFIED_ACTION=warn
# Mail the Super User (SUPER_USER_EMAIL) once about each new finding.
INTEGRITY_MAIL=true
REQUIRE_SIGNED_PLUGINS=false
PLUGIN_TRUSTED_KEYS=""

# Mail delivery
MAIL_FROM="noreply@example.com"
MAIL_FROM_NAME="HayabusaPress"

# Timezone (the database stores UTC)
APP_TIMEZONE=UTC

# Date/time display formats (PHP date() syntax. Stored as UTC, displayed in APP_TIMEZONE)
#   DATE_FORMAT     ... date only (post listings, archives, etc.). Default "Y-m-d" = 2026-06-02
#   DATETIME_FORMAT ... date and time (comments, etc.). Default "Y-m-d H:i" = 2026-06-02 01:05
#   e.g. Y/m/d="2026/06/02" . "M j, Y"="Jun 2, 2026" . "F j, Y"="June 2, 2026"
#        "Y/m/d H:i"="2026/06/02 01:05" . "M j, Y g:ia"="Jun 2, 2026 1:05am"
#   Any character that is not a format character is printed literally, so non-ASCII
#   separators work too. Escape a letter with a backslash to print it literally.
#   NOTE: after changing these, regenerate every FPC/view cache: php core/cli.php system:init
DATE_FORMAT="Y-m-d"
DATETIME_FORMAT="Y-m-d H:i"

# Year/month display format for archives (PHP date() syntax. URLs stay YYYY-MM; display only)
#   Default "Y-m"="2026-06" . e.g. Y/m="2026/06" . "F Y"="June 2026" . "M Y"="Jun 2026"
#   NOTE: after changing this, regenerate every FPC/widget cache: php core/cli.php system:init
ARCHIVE_MONTH_FORMAT="Y-m"

# Admin access protection (optional)
# Leave ADMIN_IP_ALLOWLIST empty if you have no static IP (default = unrestricted)
ADMIN_IP_ALLOWLIST=""
ADMIN_IP_MODE=enforce
REQUIRE_ADMIN_2FA=false
TRUSTED_PROXIES=""

# Spam IP blocklist for submissions
BLOCKLIST_ENABLED=true
BLOCKLIST_ON_HIT=reject
BLOCKLIST_AUTO_THRESHOLD=5
BLOCKLIST_AUTO_TTL=86400
# Spam signals (honeypot hits, DNSBL/API hits, rate limits exceeded) are counted per IP within this many
# seconds; BLOCKLIST_AUTO_THRESHOLD of them block the IP for BLOCKLIST_AUTO_TTL seconds.
BLOCKLIST_AUTO_WINDOW=3600

# Submissions per IP, as "count/seconds" (0 = no limit). Going over answers 429 and counts as a spam signal.
COMMENT_RATE_LIMIT="5/600"
CONTACT_RATE_LIMIT="3/600"

# Denylist for public page views (empty by default = unrestricted viewing)
SITE_IP_DENYLIST=""

# Scheduled publishing
# Trigger mode: pseudo (default, works anywhere) / cron (OS cron) / manual
SCHEDULE_MODE=pseudo
# Minimum interval (seconds) between pseudo-cron runs. Prevents duplicate firing.
SCHEDULE_CHECK_MIN_INTERVAL=60

# Feeds
# Physically generates per-language Atom 1.0 / RSS 2.0 feeds (refreshed when a post is published)
FEED_ENABLED=true
# Options: both (= atom,rss) | all (= atom,rss,json) | atom | rss | json, or a comma list.
# json is JSON Feed 1.1 (/feed.json); its items carry "_hbp.share_text" for posting automations.
FEED_FORMAT=both
# Maximum items per feed (5-20; values above 20 are clamped to 20)
FEED_ITEM_COUNT=20
# false = excerpt (meta_description or the first 200 characters of the body)
# true  = sanitized full content (CDATA)
FEED_FULL_CONTENT=false

# Session storage
# Options: file / database / redis / memcached
SESSION_DRIVER=database

# Connection details for SESSION_DRIVER=redis (requires ext-redis)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Connection details for SESSION_DRIVER=memcached (requires ext-memcached)
MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211

# Development mode
# Options: development / production
APP_ENV=production
